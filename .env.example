# Copiar a backend/.env para desarrollo local. NUNCA subir el .env real.

DEBUG=True
SECRET_KEY=cambia-esto-en-local
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase (Settings > Database > Connection string > Session pooler).
# Sustituir [PASSWORD] y [PROJECT-REF] cuando exista el proyecto de Supabase.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

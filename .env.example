# Copiar a backend/.env para desarrollo local. NUNCA subir el .env real.

DEBUG=True
SECRET_KEY=cambia-esto-en-local
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------
# Base de datos: deja activa (sin #) SOLO UNA de estas opciones.
# ---------------------------------------------------------------------

# Opción A · PostgreSQL local (laboratorio de pruebas).
# 1. Crear la base:   psql -U postgres -c "CREATE DATABASE bearstards;"
# 2. Crear tablas:    psql -U postgres -d bearstards -f docs/laboratorio-pruebas/sql/00_esquema.sql
# 3. Cargar datos:    psql -U postgres -d bearstards -f docs/laboratorio-pruebas/sql/02_carga.sql
# Sustituir TU_PASSWORD por la contraseña del usuario postgres de tu instalación.
DATABASE_URL=postgres://postgres:TU_PASSWORD@localhost:5432/bearstards

# Opción B · Supabase (Connect > Session pooler > URI).
# Sustituir [PROJECT-REF] y [PASSWORD]. Si la contraseña tiene @ # / : % ?,
# codificarlos en la URL (por ejemplo @ = %40).
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:5432/postgres